# desktop-organizer configuration.
# Values in the "${X:-default}" form can be overridden with environment
# variables on a one-off run (handy for debugging).

# Daily run time. After changing it, re-run ./install.sh so the launchd
# agent picks up the new schedule.
RUN_HOUR="${RUN_HOUR:-10}"
RUN_MINUTE="${RUN_MINUTE:-30}"

# Folder to watch.
DESKTOP_DIR="${DESKTOP_DIR:-$HOME/Desktop}"

# Where to put the date folders (the same desktop by default).
ARCHIVE_DIR="${ARCHIVE_DIR:-$HOME/Desktop}"

# How many days back to "catch up": if the computer was off for a few days
# or a file previously failed to move, files from the last N days are sorted
# on the next run. Older files are left untouched.
CATCH_UP_DAYS="${CATCH_UP_DAYS:-14}"

# launchd agent label (no need to change).
LAUNCHD_LABEL="${LAUNCHD_LABEL:-com.desktop-organizer.daily}"
